# ============================================================
# WORKSHOP IA - Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no repositório!

# ------------------------------------------------------------
# GITHUB
# Obtenha em: github.com -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic)
# Permissões necessárias: repo, workflow, read:org
# ------------------------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=

# ------------------------------------------------------------
# VERCEL
# Obtenha em: vercel.com -> Settings -> Tokens -> Create Token
# ------------------------------------------------------------
VERCEL_TOKEN=

# ------------------------------------------------------------
# NEON (PostgreSQL Serverless)
# Obtenha em: console.neon.tech -> Settings -> API Keys -> Create API Key
# ------------------------------------------------------------
NEON_API_KEY=
# Obtido em: console.neon.tech -> seu projeto -> Connection Details -> Connection string (pooled)
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/helpdb?sslmode=require
# Obtido em: console.neon.tech -> Connection Details -> Direct connection
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/helpdb?sslmode=require

# ------------------------------------------------------------
# GOOGLE OAUTH (para "Entrar com Google")
# Obtenha em: console.cloud.google.com -> APIs & Services -> Credentials
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------
# RESEND (E-mail transacional) - opcional
# Obtenha em: resend.com -> API Keys -> Create API Key
# ------------------------------------------------------------
RESEND_API_KEY=

# ------------------------------------------------------------
# STRIPE (Pagamentos) - opcional
# Obtenha em: dashboard.stripe.com -> Developers -> API Keys
# Use a chave SECRET (sk_test_... para testes)
# ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
